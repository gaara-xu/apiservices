{
  "openapi": "3.1.0",
  "info": {
    "title": "Mac AI 图像识别接口",
    "version": "0.3.7"
  },
  "paths": {
    "/api/v1/preference/features/{run_id}/{job_id}": {
      "get": {
        "tags": [
          "个人喜好"
        ],
        "summary": "Export Feature",
        "description": "导出已提取特征供110在删除原图前持久保留，不修改模型。",
        "operationId": "export_feature_api_v1_preference_features__run_id___job_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/preference/retained/{job_id}": {
      "post": {
        "tags": [
          "个人喜好"
        ],
        "summary": "Retained",
        "description": "恢复110保留的人工样本特征到本轮训练并回调，不需要原图。",
        "operationId": "retained_api_v1_preference_retained__job_id__post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "run_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Label"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "title": "Feature"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/preference/match-rate": {
      "post": {
        "tags": [
          "个人喜好"
        ],
        "summary": "Match Rate",
        "description": "并发接收URL和Base64批次，GIF按首帧用同一喜好版本计算命中占比，仅返回百分比；任一失败不输出失真比例。",
        "operationId": "match_rate_api_v1_preference_match_rate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchRateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/preference/detect": {
      "post": {
        "tags": [
          "个人喜好"
        ],
        "summary": "Detect",
        "description": "并发批量检测个人喜好，冻结本轮模型版本，逐图返回结果且不写学习数据或回调110。",
        "operationId": "detect_api_v1_preference_detect_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/preference/status": {
      "get": {
        "tags": [
          "个人喜好"
        ],
        "summary": "Status",
        "description": "返回已训练模型状态，与SigLIP加载状态分别展示。",
        "operationId": "status_api_v1_preference_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/preference/finalize/{run_id}": {
      "post": {
        "tags": [
          "个人喜好"
        ],
        "summary": "Finalize",
        "description": "按110成功样本清单拟合并发布模型，忽略未确认候选，重复调用返回同版本。",
        "operationId": "finalize_api_v1_preference_finalize__run_id__post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "expected",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Expected"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Job Ids"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/preference/reuse/{job_id}": {
      "post": {
        "tags": [
          "个人喜好"
        ],
        "summary": "Reuse",
        "description": "接收110缓存复用请求，应用最新标签并回调，缓存缺失时允许110回退传图。",
        "operationId": "reuse_api_v1_preference_reuse__job_id__post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "run_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Label"
            }
          },
          {
            "name": "source_run_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Source Run Id"
            }
          },
          {
            "name": "source_job_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Source Job Id"
            }
          },
          {
            "name": "content_sha256",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Content Sha256"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/preference/jobs/{job_id}": {
      "post": {
        "tags": [
          "个人喜好"
        ],
        "summary": "Job",
        "description": "接收二进制图片并在线程计算回调；仅训练请求互斥，筛查并发接收。",
        "operationId": "job_api_v1_preference_jobs__job_id__post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "run_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Kind"
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Label"
            }
          },
          {
            "name": "model_version",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Model Version"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "summary": "Live",
        "description": "返回服务标识、进程编号和实例令牌，供生命周期脚本确认身份。",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "description": "模型加载完成才返回就绪，否则返回503及加载状态。",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/model": {
      "get": {
        "summary": "Model Info",
        "description": "提供本地模型名称、运行设备、状态及请求限制。",
        "operationId": "model_info_api_v1_model_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/images/embeddings": {
      "post": {
        "summary": "Embeddings",
        "description": "读取指定共享图片并返回L2归一化的视觉特征向量。",
        "operationId": "embeddings_api_v1_images_embeddings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/images/classify": {
      "post": {
        "summary": "Classify",
        "description": "按照用户提供的候选标签对图片评分排序，不判断未经训练的个人喜好。",
        "operationId": "classify_api_v1_images_classify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClassifyRequest": {
        "properties": {
          "paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 16,
            "minItems": 1,
            "title": "Paths"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 32,
            "minItems": 2,
            "title": "Labels"
          }
        },
        "type": "object",
        "required": [
          "paths",
          "labels"
        ],
        "title": "ClassifyRequest"
      },
      "DetectionImage": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "data_base64": {
            "type": "string",
            "title": "Data Base64"
          }
        },
        "type": "object",
        "required": [
          "id",
          "data_base64"
        ],
        "title": "DetectionImage"
      },
      "DetectionRequest": {
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/DetectionImage"
            },
            "type": "array",
            "minItems": 1,
            "title": "Images"
          },
          "threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Threshold",
            "default": 0.5
          }
        },
        "type": "object",
        "required": [
          "images"
        ],
        "title": "DetectionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageRequest": {
        "properties": {
          "paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 16,
            "minItems": 1,
            "title": "Paths"
          }
        },
        "type": "object",
        "required": [
          "paths"
        ],
        "title": "ImageRequest"
      },
      "MatchRateRequest": {
        "properties": {
          "urls": {
            "items": {
              "type": "string",
              "maxLength": 2083,
              "minLength": 1,
              "format": "uri"
            },
            "type": "array",
            "title": "Urls"
          },
          "images": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Images"
          },
          "threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Threshold",
            "default": 0.5
          }
        },
        "type": "object",
        "title": "MatchRateRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
